import QuantitativeStochasticHomogenization.Front.Assumptions

/-!
# A jointly measurable version of the coefficient field

Armstrong–Kuusi–Mourrat, *Quantitative Stochastic Homogenization and Large-Scale Regularity*, the
chapter "Assumptions and Examples", (0.6)–(0.8).

The σ-algebra of the coefficient fields is generated by the test integrals `∫ u a_{ij}`, so the
value `a(x)` at a point is not a measurable function of `a`. The mollifications `φₙ ∗ a_{ij}` are
test integrals for each `x` and continuous in `x`, hence jointly measurable in `(a, x)`; their
`liminf` is a jointly measurable function `coefficientVersion` which, by the Lebesgue
differentiation theorem, agrees with `a(x)` for almost every `x`, for every `a`
(`ae_coefficientVersion_eq`).
-/

open MeasureTheory Filter
open scoped Topology Convolution

noncomputable section

namespace QSH

variable {d : ℕ} {Λ : ℝ}

/-- The bump function of inner radius `1/(n+2)` and outer radius `1/(n+1)` used to mollify. -/
def mollifierBump (d : ℕ) (n : ℕ) : ContDiffBump (0 : Vec d) where
  rIn := 1 / ((n : ℝ) + 2)
  rOut := 1 / ((n : ℝ) + 1)
  rIn_pos := by positivity
  rIn_lt_rOut := one_div_lt_one_div_of_lt (by positivity) (by linarith)

/-- The mollified entry `(φₙ ∗ a_{ij})(x)`. -/
def mollifiedEntry (n : ℕ) (i j : Fin d) (a : CoefficientField d Λ) (x : Vec d) : ℝ :=
  ((mollifierBump d n).normed volume ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume]
    fun y => a.field y i j) x

/-- The test function `y ↦ φₙ(x - y)`. -/
def mollifierTest (n : ℕ) (x : Vec d) : SmoothCompactTest d where
  toFun y := (mollifierBump d n).normed volume (x - y)
  smooth := (mollifierBump d n).contDiff_normed.comp (contDiff_const.sub contDiff_id)
  compact := (mollifierBump d n).hasCompactSupport_normed.comp_homeomorph (Homeomorph.subLeft x)

theorem mollifiedEntry_eq_testIntegral (n : ℕ) (i j : Fin d) (a : CoefficientField d Λ)
    (x : Vec d) : mollifiedEntry n i j a x = testIntegral a (mollifierTest n x) i j := by
  rw [mollifiedEntry, convolution_eq_swap, testIntegral]
  rfl

theorem measurable_testIntegral (u : SmoothCompactTest d) (i j : Fin d) :
    Measurable (fun a : CoefficientField d Λ => testIntegral a u i j) := by
  rw [measurable_iff_comap_le]
  exact le_iSup_of_le u (le_iSup_of_le i (le_iSup_of_le j le_rfl))

theorem continuous_mollifiedEntry (n : ℕ) (i j : Fin d) (a : CoefficientField d Λ) :
    Continuous (mollifiedEntry n i j a) :=
  (mollifierBump d n).hasCompactSupport_normed.continuous_convolution_left
    (ContinuousLinearMap.lsmul ℝ ℝ) (mollifierBump d n).continuous_normed
    (a.locally_integrable i j)

theorem measurable_mollifiedEntry (n : ℕ) (i j : Fin d) :
    Measurable (fun p : CoefficientField d Λ × Vec d => mollifiedEntry n i j p.1 p.2) := by
  have h : Measurable (Function.uncurry fun (x : Vec d) (a : CoefficientField d Λ) =>
      mollifiedEntry n i j a x) :=
    measurable_uncurry_of_continuous_of_measurable
      (fun a => continuous_mollifiedEntry n i j a) fun x => by
        simp only [mollifiedEntry_eq_testIntegral]
        exact measurable_testIntegral _ i j
  exact h.comp measurable_swap

/-- The entry `(i, j)` of the jointly measurable version: `liminf (φₙ ∗ a_{ij})(x)`. -/
def coefficientVersionEntry (i j : Fin d) (a : CoefficientField d Λ) (x : Vec d) : ℝ :=
  liminf (fun n => mollifiedEntry n i j a x) atTop

/-- **The jointly measurable version of the coefficient field.** -/
def coefficientVersion (a : CoefficientField d Λ) (x : Vec d) : Mat d :=
  Matrix.of fun i j => coefficientVersionEntry i j a x

theorem measurable_coefficientVersionEntry (i j : Fin d) :
    Measurable (fun p : CoefficientField d Λ × Vec d => coefficientVersionEntry i j p.1 p.2) :=
  Measurable.liminf fun n => measurable_mollifiedEntry n i j

theorem measurable_coefficientVersion :
    Measurable (fun p : CoefficientField d Λ × Vec d => coefficientVersion p.1 p.2) := by
  refine measurable_pi_iff.mpr fun i => measurable_pi_iff.mpr fun j => ?_
  exact measurable_coefficientVersionEntry i j

/-- For every coefficient field, `coefficientVersion a x = a(x)` for almost every `x`. -/
theorem ae_coefficientVersion_eq (a : CoefficientField d Λ) :
    ∀ᵐ x ∂(volume : Measure (Vec d)), coefficientVersion a x = a.field x := by
  have hentry : ∀ i j : Fin d, ∀ᵐ x ∂(volume : Measure (Vec d)),
      coefficientVersionEntry i j a x = a.field x i j := fun i j => by
    have hφ : Tendsto (fun n => (mollifierBump d n).rOut) atTop (𝓝 0) := by
      simp only [mollifierBump]
      exact tendsto_one_div_add_atTop_nhds_zero_nat
    have hK : ∀ᶠ n in atTop, (mollifierBump d n).rOut ≤ 2 * (mollifierBump d n).rIn :=
      Eventually.of_forall fun n => by
        simp only [mollifierBump]
        rw [div_le_iff₀ (by positivity), mul_comm, ← mul_assoc, mul_one_div, le_div_iff₀
          (by positivity)]
        linarith
    filter_upwards [ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable hφ hK
      (a.locally_integrable i j)] with x hx
    exact hx.liminf_eq
  have hall := (ae_all_iff.mpr fun i => ae_all_iff.mpr fun j => hentry i j)
  filter_upwards [hall] with x hx
  ext i j
  exact hx i j

end QSH
