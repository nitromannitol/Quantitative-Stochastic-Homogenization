import QuantitativeStochasticHomogenization.Front.Notation

/-!
# Assumptions and Examples

Armstrong–Kuusi–Mourrat, *Quantitative Stochastic Homogenization and Large-Scale Regularity*, the
chapter "Assumptions and Examples" before Chapter 1: the standing assumptions of the book (uniform
ellipticity (0.6), stationarity (0.10) and unit range of dependence (0.11)) and the examples
satisfying them.

Defined here: the set of coefficient fields (0.6), its σ-algebra generated by test integrals
(0.7)-(0.8), the local σ-algebras `F(U)` (0.9), the translations, and the assumptions (P1)-(P2)
(0.10)-(0.11) on the law.
-/

open MeasureTheory

noncomputable section

namespace QSH

/-! ## The coefficient fields and their law, (0.6)-(0.11) -/

/-- Smooth compactly supported tests observing the coefficients, (0.7). -/
structure SmoothCompactTest (d : ℕ) where
  toFun : Vec d → ℝ
  smooth : ContDiff ℝ (⊤ : ℕ∞) toFun
  compact : HasCompactSupport toFun

instance {d : ℕ} : CoeFun (SmoothCompactTest d) (fun _ => Vec d → ℝ) :=
  ⟨SmoothCompactTest.toFun⟩

/-- **The set `Ω` of coefficient fields**, (0.6): locally integrable symmetric matrix fields with
`|ξ|² ≤ ξ·a(x)ξ ≤ Λ|ξ|²`. -/
structure CoefficientField (d : ℕ) (Λ : ℝ) where
  field : Vec d → Mat d
  locally_integrable : ∀ i j, LocallyIntegrable (fun x => field x i j) volume
  symmetric : ∀ x, (field x).transpose = field x
  elliptic : ∀ x ξ, euclideanSq ξ ≤ dot ξ ((field x).mulVec ξ) ∧
    dot ξ ((field x).mulVec ξ) ≤ Λ * euclideanSq ξ

instance {d : ℕ} {Λ : ℝ} : CoeFun (CoefficientField d Λ) (fun _ => Vec d → Mat d) :=
  ⟨CoefficientField.field⟩

/-- The test integral `∫ u a_{ij}` of (0.7). -/
def testIntegral {d : ℕ} {Λ : ℝ} (a : CoefficientField d Λ) (u : SmoothCompactTest d)
    (i j : Fin d) : ℝ :=
  ∫ x, u x * a.field x i j

/-- The σ-algebra `F` of (0.8), generated by the test integrals. -/
instance {d : ℕ} {Λ : ℝ} : MeasurableSpace (CoefficientField d Λ) :=
  ⨆ u : SmoothCompactTest d, ⨆ i : Fin d, ⨆ j : Fin d,
    MeasurableSpace.comap (fun a : CoefficientField d Λ => testIntegral a u i j) inferInstance

/-- The local σ-algebra `F(U)` of (0.9), generated by tests supported in `U`. -/
@[instance_reducible]
def localSigma {d : ℕ} {Λ : ℝ} (U : Set (Vec d)) : MeasurableSpace (CoefficientField d Λ) :=
  ⨆ u : {u : SmoothCompactTest d // tsupport u.toFun ⊆ U}, ⨆ i : Fin d, ⨆ j : Fin d,
    MeasurableSpace.comap (fun a : CoefficientField d Λ => testIntegral a u.1 i j) inferInstance

/-- The translation `T_y a = a(y + ·)` of (0.10). -/
def translate {d : ℕ} {Λ : ℝ} (y : Vec d) (a : CoefficientField d Λ) : CoefficientField d Λ where
  field := fun x => a.field (y + x)
  locally_integrable := fun i j => by
    have hmap : Measure.map (Homeomorph.addLeft y) (volume : Measure (Vec d)) = volume :=
      (measurePreserving_add_left volume y).map_eq
    have hf : LocallyIntegrable (fun x => a.field x i j)
        (Measure.map (Homeomorph.addLeft y) volume) := by
      rw [hmap]
      exact a.locally_integrable i j
    exact (locallyIntegrable_map_homeomorph (Homeomorph.addLeft y)).1 hf
  symmetric := fun x => a.symmetric (y + x)
  elliptic := fun x ξ => a.elliptic (y + x) ξ

/-- **The assumptions (P1)-(P2) on the law**, (0.10)-(0.11): `P` is a probability measure,
invariant under the lattice translations, and the σ-algebras of sets at distance larger than one
are independent. -/
def LawHypotheses {d : ℕ} {Λ : ℝ} (P : Measure (CoefficientField d Λ)) : Prop :=
  IsProbabilityMeasure P ∧
  (∀ z : LatticeIndex d, Measure.map (translate (latticeShift z)) P = P) ∧
  ∀ U W : Set (Vec d), MeasurableSet U → MeasurableSet W →
    (∃ t : ℝ, 1 < t ∧ ∀ x ∈ U, ∀ y ∈ W, t ≤ euclideanNorm (x - y)) →
    ProbabilityTheory.Indep (localSigma U) (localSigma W) P

end QSH
