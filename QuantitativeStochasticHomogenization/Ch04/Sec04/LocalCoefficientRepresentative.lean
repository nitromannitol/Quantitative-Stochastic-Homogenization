import QuantitativeStochasticHomogenization.Ch04.Sec04.HarmonicPairSpace
import Mathlib.Analysis.Calculus.BumpFunction.Convolution

/-!
# A jointly measurable local representative of the coefficients on a ball

Armstrong–Kuusi–Mourrat, *Quantitative Stochastic Homogenization and Large-Scale Regularity*,
(0.8): the local σ-algebra `F(U)` is generated by the test integrals `∫ u a_{ij}` with smooth `u`
supported in `U`. Point evaluation of `a` is not measurable for it, but the averages of `a` against
smooth bumps of radius `1/(n+1)` centered at `x` are, as long as the bump lies in the ball
`B_T(z)`; a continuous gate in `x` keeps only those. The upper limit of the gated averages is a
representative of `a` on `B_T(z)` (Lebesgue differentiation) which is jointly measurable in
`(x, a)` for `Borel ⊗ F(B_T(z))`. Consequently `a ↦ ∫_{B_T(z)} g a_{ij}` is
`F(B_T(z))`-measurable for every integrable `g`.

The averaging kernels follow the measurable representative of the source coefficients in the
formalization of the Einstein relation (`AKMMeasurableRepresentative`).
-/

open MeasureTheory Filter Topology
open scoped Convolution

noncomputable section

namespace QSH

variable {d : ℕ} {Λ : ℝ}

/-- Normalized smooth averaging kernels of radius `1/(n+1)`. -/
def averagingBump (d n : ℕ) : ContDiffBump (0 : Vec d) where
  rIn := 1 / ((n : ℝ) + 1) / 2
  rOut := 1 / ((n : ℝ) + 1)
  rIn_pos := by positivity
  rIn_lt_rOut := by
    have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    linarith

/-- The averaging kernel centered at `x`, as a coefficient test. -/
def averagingTest (x : Vec d) (n : ℕ) : SmoothCompactTest d :=
  ⟨fun y => (averagingBump d n).normed volume (x - y),
    (averagingBump d n).contDiff_normed.comp (contDiff_const.sub contDiff_id),
    (averagingBump d n).hasCompactSupport_normed.comp_homeomorph (Homeomorph.subLeft x)⟩

theorem tsupport_averagingTest_subset (x : Vec d) (n : ℕ) :
    tsupport (averagingTest x n).toFun ⊆ Metric.closedBall x (1 / ((n : ℝ) + 1)) := by
  refine closure_minimal (fun y hy => ?_) Metric.isClosed_closedBall
  have h : x - y ∈ Function.support ((averagingBump d n).normed volume) := hy
  rw [ContDiffBump.support_normed_eq, Metric.mem_ball, dist_zero_right] at h
  rw [Metric.mem_closedBall, dist_eq_norm, ← norm_neg, neg_sub]
  exact h.le

theorem continuous_averagingObservation (n : ℕ) (i j : Fin d) (a : CoefficientField d Λ) :
    Continuous fun x => testIntegral a (averagingTest x n) i j := by
  have h := ((averagingBump d n).hasCompactSupport_normed (μ := volume)).continuous_convolution_left
    (ContinuousLinearMap.lsmul ℝ ℝ) ((averagingBump d n).continuous_normed (μ := volume))
    (a.locally_integrable i j)
  convert h using 1
  funext x
  exact (convolution_lsmul_swap (μ := (volume : Measure (Vec d)))
    (f := (averagingBump d n).normed volume) (g := fun y => a.field y i j) (x := x)).symm

theorem ae_tendsto_averagingObservation (a : CoefficientField d Λ) (i j : Fin d) :
    ∀ᵐ x ∂(volume : Measure (Vec d)),
      Tendsto (fun n => testIntegral a (averagingTest x n) i j) atTop (𝓝 (a x i j)) := by
  have hratio : ∀ᶠ n : ℕ in atTop,
      (averagingBump d n).rOut ≤ (2 : ℝ) * (averagingBump d n).rIn := by
    filter_upwards with n
    dsimp only [averagingBump]
    linarith
  have h := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable
    (μ := (volume : Measure (Vec d))) (φ := averagingBump d)
    tendsto_one_div_add_atTop_nhds_zero_nat hratio (a.locally_integrable i j)
  simpa only [convolution_eq_swap, ContinuousLinearMap.lsmul_apply, smul_eq_mul,
    testIntegral, averagingTest] using h

/-- The Euclidean norm is at most `d` times the sup norm. -/
theorem euclideanNorm_le_mul_norm (v : Vec d) : euclideanNorm v ≤ d * ‖v‖ := by
  have hsum : euclideanSq v ≤ d * ‖v‖ ^ 2 := by
    show ∑ i, v i * v i ≤ _
    calc ∑ i, v i * v i ≤ ∑ _i : Fin d, ‖v‖ ^ 2 := Finset.sum_le_sum fun i _ => by
          calc v i * v i = |v i| ^ 2 := by rw [sq_abs, sq]
            _ ≤ ‖v‖ ^ 2 := pow_le_pow_left₀ (abs_nonneg _)
                (by simpa [Real.norm_eq_abs] using norm_le_pi_norm v i) 2
      _ = d * ‖v‖ ^ 2 := by simp
  refine (Real.sqrt_le_sqrt hsum).trans ((Real.sqrt_le_left (by positivity)).2 ?_)
  have hd : (d : ℝ) ≤ (d : ℝ) ^ 2 := by
    rcases Nat.eq_zero_or_pos d with h | h
    · simp [h]
    · have : (1 : ℝ) ≤ d := by exact_mod_cast h
      nlinarith
  calc (d : ℝ) * ‖v‖ ^ 2 ≤ (d : ℝ) ^ 2 * ‖v‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hd (sq_nonneg _)
    _ = ((d : ℝ) * ‖v‖) ^ 2 := by ring

/-- The gate keeping the averages whose kernel lies in `B_T(z)`. -/
def ballGate (z : Vec d) (T : ℝ) (n : ℕ) (x : Vec d) : ℝ :=
  max 0 (min 1 ((T - euclideanNorm (x - z) - d * (1 / ((n : ℝ) + 1))) * ((n : ℝ) + 1)))

theorem continuous_ballGate (z : Vec d) (T : ℝ) (n : ℕ) : Continuous (ballGate z T n) :=
  continuous_const.max (continuous_const.min
    (((continuous_const.sub (euclideanNorm_continuous.comp
      (continuous_id.sub continuous_const))).sub continuous_const).mul continuous_const))

theorem closedBall_subset_ball_of_ballGate_ne_zero {z : Vec d} {T : ℝ} {n : ℕ} {x : Vec d}
    (hx : ballGate z T n x ≠ 0) :
    Metric.closedBall x (1 / ((n : ℝ) + 1)) ⊆ ball z T := by
  have hpos : 0 < T - euclideanNorm (x - z) - d * (1 / ((n : ℝ) + 1)) := by
    by_contra hle
    push Not at hle
    apply hx
    have : (T - euclideanNorm (x - z) - d * (1 / ((n : ℝ) + 1))) * ((n : ℝ) + 1) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hle (by positivity)
    simp only [ballGate]
    exact max_eq_left (min_le_of_right_le this)
  intro y hy
  rw [Metric.mem_closedBall, dist_eq_norm] at hy
  show euclideanNorm (y - z) < T
  have h1 := euclideanNorm_sub_le_sub_add y z x
  have h2 := euclideanNorm_le_mul_norm (y - x)
  have h3 : (d : ℝ) * ‖y - x‖ ≤ d * (1 / ((n : ℝ) + 1)) :=
    mul_le_mul_of_nonneg_left hy (Nat.cast_nonneg d)
  linarith

theorem ballGate_eventually_eq_one {z : Vec d} {T : ℝ} {x : Vec d} (hx : x ∈ ball z T) :
    ∀ᶠ n : ℕ in atTop, ballGate z T n x = 1 := by
  have hx' : 0 < T - euclideanNorm (x - z) := sub_pos.2 hx
  set δ := T - euclideanNorm (x - z)
  have hlim : Tendsto (fun n : ℕ => (δ - d * (1 / ((n : ℝ) + 1))) * ((n : ℝ) + 1)) atTop atTop := by
    have h1 : Tendsto (fun n : ℕ => δ * ((n : ℝ) + 1)) atTop atTop :=
      (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds).const_mul_atTop hx'
    refine (tendsto_atTop_add_const_right _ (-(d : ℝ)) h1).congr fun n => ?_
    field_simp
    ring
  filter_upwards [hlim.eventually_ge_atTop 1] with n hn
  simp only [ballGate]
  rw [min_eq_left (by simpa [δ] using hn)]
  norm_num

/-- The gated average of `a_{ij}` at scale `1/(n+1)` around `x`. -/
def gatedObservation (z : Vec d) (T : ℝ) (i j : Fin d) (n : ℕ) (x : Vec d)
    (a : CoefficientField d Λ) : ℝ :=
  ballGate z T n x * testIntegral a (averagingTest x n) i j

/-- **The local representative** of `a_{ij}` on `B_T(z)`. -/
def localRepresentative (z : Vec d) (T : ℝ) (i j : Fin d) (a : CoefficientField d Λ)
    (x : Vec d) : ℝ :=
  limsup (fun n => gatedObservation z T i j n x a) atTop

theorem measurable_testIntegral_localSigma {U : Set (Vec d)} (u : SmoothCompactTest d)
    (hu : tsupport u.toFun ⊆ U) (i j : Fin d) :
    @Measurable (CoefficientField d Λ) ℝ (localSigma U) _ fun a => testIntegral a u i j := by
  rw [measurable_iff_comap_le]
  exact le_iSup_of_le ⟨u, hu⟩ (le_iSup_of_le i (le_iSup_of_le j le_rfl))

theorem measurable_gatedObservation (z : Vec d) (T : ℝ) (i j : Fin d) (n : ℕ) (x : Vec d) :
    @Measurable (CoefficientField d Λ) ℝ (localSigma (ball z T)) _
      (gatedObservation z T i j n x) := by
  by_cases hx : ballGate z T n x = 0
  · have : gatedObservation (Λ := Λ) z T i j n x = fun _ => 0 := by
      funext a; simp [gatedObservation, hx]
    rw [this]
    exact @measurable_const _ _ _ (localSigma (ball z T)) _
  · exact (measurable_testIntegral_localSigma (averagingTest x n)
      ((tsupport_averagingTest_subset x n).trans
        (closedBall_subset_ball_of_ballGate_ne_zero hx)) i j).const_mul _

theorem measurable_localRepresentative (z : Vec d) (T : ℝ) (i j : Fin d) :
    @Measurable (Vec d × CoefficientField d Λ) ℝ
      (@Prod.instMeasurableSpace _ _ _ (localSigma (ball z T))) _
      (fun p => localRepresentative z T i j p.2 p.1) := by
  have h : ∀ n, @Measurable (Vec d × CoefficientField d Λ) ℝ
      (@Prod.instMeasurableSpace _ _ _ (localSigma (ball z T))) _
      (Function.uncurry (gatedObservation z T i j n)) := fun n =>
    measurable_uncurry_of_continuous_of_measurable (m := localSigma (ball z T))
      (fun a => (continuous_ballGate z T n).mul (continuous_averagingObservation n i j a))
      (fun x => measurable_gatedObservation z T i j n x)
  exact Measurable.limsup (mδ := @Prod.instMeasurableSpace _ _ _ (localSigma (ball z T))) h

theorem localRepresentative_ae_eq (z : Vec d) (T : ℝ) (i j : Fin d) (a : CoefficientField d Λ) :
    ∀ᵐ x ∂(ballMeasure z T), localRepresentative z T i j a x = a x i j := by
  rw [ae_restrict_iff' (measurableSet_ball z T)]
  filter_upwards [ae_tendsto_averagingObservation a i j] with x hx hxB
  unfold localRepresentative
  rw [limsup_congr (f := atTop) (v := fun n => testIntegral a (averagingTest x n) i j)]
  · exact hx.limsup_eq
  · filter_upwards [ballGate_eventually_eq_one hxB] with n hn
    simp [gatedObservation, hn]

/-- **Local test integrals against integrable functions are `F(B_T(z))`-measurable.** -/
theorem measurable_setIntegral_mul_coefficient (z : Vec d) (T : ℝ) {g : Vec d → ℝ}
    (hg : Integrable g (ballMeasure z T)) (i j : Fin d) :
    @Measurable (CoefficientField d Λ) ℝ (localSigma (ball z T)) _
      fun a => ∫ x in ball z T, g x * a x i j := by
  set g' := hg.aestronglyMeasurable.mk g
  have hg'm : StronglyMeasurable g' := hg.aestronglyMeasurable.stronglyMeasurable_mk
  have heq : (fun a : CoefficientField d Λ => ∫ x in ball z T, g x * a x i j) =
      fun a => ∫ x, g' x * localRepresentative z T i j a x ∂(ballMeasure z T) := by
    funext a
    refine integral_congr_ae ?_
    filter_upwards [hg.aestronglyMeasurable.ae_eq_mk, localRepresentative_ae_eq z T i j a] with
      x hx1 hx2
    rw [hx1, hx2]
  rw [heq]
  let : MeasurableSpace (CoefficientField d Λ) := localSigma (ball z T)
  have hjoint : Measurable (fun p : Vec d × CoefficientField d Λ =>
      localRepresentative z T i j p.2 p.1) := measurable_localRepresentative (Λ := Λ) z T i j
  have hf : StronglyMeasurable
      (fun p : Vec d × CoefficientField d Λ => g' p.1 * localRepresentative z T i j p.2 p.1) :=
    (hg'm.comp_measurable measurable_fst).mul hjoint.stronglyMeasurable
  exact hf.integral_prod_left'.measurable

end QSH
